# AZURE_DEVOPS_ORG 环境变量示例
# Azure DevOps 组织的 URL
# 格式: https://dev.azure.com/yourorganization
AZURE_DEVOPS_ORG=https://dev.azure.com/yourorganization

# AZURE_DEVOPS_PROJECT 环境变量
# Azure DevOps 项目的名称
AZURE_DEVOPS_PROJECT=YourProjectName

# AZURE_DEVOPS_TOKEN 环境变量
# Personal Access Token (PAT)
# 获取方法:
# 1. 访问 https://dev.azure.com/yourorganization
# 2. 点击右上角用户头像
# 3. 选择 "User settings"
# 4. 左侧菜单 → "Personal access tokens"
# 5. 点击 "New Token"
# 6. 设置:
#    - 名称: azure-devops-mcp-csharp
#    - 权限范围: 勾选 "Test Management (Read)"
#    - 过期时间: 选择合适的时间
# 7. 创建并复制 token
AZURE_DEVOPS_TOKEN=your-pat-token-here
